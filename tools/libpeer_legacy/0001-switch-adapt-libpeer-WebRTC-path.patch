+static void dtls_srtp_set_delay(void* data, uint32_t int_ms, uint32_t fin_ms) {
+  DtlsSrtpTimer* timer = (DtlsSrtpTimer*)data;
+  timer->int_ms = int_ms;
+  timer->fin_ms = fin_ms;
+  timer->start_ms = fin_ms ? ports_get_epoch_time() : 0;
+}
+
+static int dtls_srtp_get_delay(void* data) {
+  DtlsSrtpTimer* timer = (DtlsSrtpTimer*)data;
+  if (timer->fin_ms == 0) {
+    return -1;
+  }
+
+  uint32_t elapsed_ms = ports_get_epoch_time() - timer->start_ms;
+  if (elapsed_ms >= timer->fin_ms) {
+    return 2;
+  }
+  if (elapsed_ms >= timer->int_ms) {
+    return 1;
+  }
+  return 0;
+}
