+
+static int rtp_payload(uint8_t* packet, size_t size, uint8_t** payload, size_t* payload_size) {
+  if (!packet || size < 12 || !payload || !payload_size) {
+    return -1;
+  }
+
+  size_t offset = 12 + ((size_t)(packet[0] & 0x0f) * 4);
+  if (offset > size) {
+    return -1;
+  }
+
+  if (packet[0] & 0x10) {
+    if (offset + 4 > size) {
+      return -1;
+    }
+    size_t extension_words = rtp_read_u16(packet + offset + 2);
+    offset += 4 + extension_words * 4;
+    if (offset > size) {
+      return -1;
+    }
+  }
+
+  size_t padding_size = 0;
+  if (packet[0] & 0x20) {
+    padding_size = packet[size - 1];
+    if (padding_size == 0 || padding_size > size - offset) {
+      return -1;
+    }
+  }
+
+  *payload = packet + offset;
+  *payload_size = size - offset - padding_size;
+  return 0;
+}
+
+static uint16_t rtp_sequence(uint8_t* packet, size_t size) {
+  if (!packet || size < 4) {
+    return 0;
+  }
+  return rtp_read_u16(packet + 2);
+}
+
+static int rtp_marker(uint8_t* packet, size_t size) {
+  if (!packet || size < 2) {
+    return 0;
+  }
+  return (packet[1] & 0x80) != 0;
+}
+
+static uint32_t rtp_timestamp(uint8_t* packet, size_t size) {
+  if (!packet || size < 8) {
+    return 0;
+  }
+  return rtp_read_u32(packet + 4);
+}
