diff --git a/library/asn1write.c b/library/asn1write.c
index b9d586aef..18df05f79 100644
--- a/library/asn1write.c
+++ b/library/asn1write.c
@@ -23,11 +23,24 @@
 
 #include "mbedtls/asn1write.h"
 #include "mbedtls/error.h"
+#include "mbedtls/oid.h"
 
 #include <string.h>
 
 #include "mbedtls/platform.h"
 
+static int mbedtls_asn1_algorithm_identifier_omits_params(const char *oid,
+                                                          size_t oid_len)
+{
+#define OID_EQUALS(value) (oid_len == sizeof(value) - 1 && memcmp(oid, value, sizeof(value) - 1) == 0)
+    return OID_EQUALS(MBEDTLS_OID_ECDSA_SHA1) ||
+           OID_EQUALS(MBEDTLS_OID_ECDSA_SHA224) ||
+           OID_EQUALS(MBEDTLS_OID_ECDSA_SHA256) ||
+           OID_EQUALS(MBEDTLS_OID_ECDSA_SHA384) ||
+           OID_EQUALS(MBEDTLS_OID_ECDSA_SHA512);
+#undef OID_EQUALS
+}
+
 int mbedtls_asn1_write_len(unsigned char **p, const unsigned char *start, size_t len)
 {
     if (len < 0x80) {
@@ -198,7 +211,7 @@ int mbedtls_asn1_write_algorithm_identifier(unsigned char **p, const unsigned ch
     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
     size_t len = 0;
 
-    if (par_len == 0) {
+    if (par_len == 0 && !mbedtls_asn1_algorithm_identifier_omits_params(oid, oid_len)) {
         MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_null(p, start));
     } else {
         len += par_len;
