new file mode 100644
index 0000000000000000000000000000000000000000..7f1a8508f7e6bd53e460cea53b04fb3180702dfe
--- /dev/null
+++ b/usrsctplib/switch_compat.h
@@ -0,0 +1,57 @@
+#pragma once
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <errno.h>
+
+#ifndef CMSG_ALIGN
+#ifdef _ALIGN
+#define CMSG_ALIGN(n) _ALIGN(n)
+#else
+#define CMSG_ALIGN(n) (((n) + sizeof(long) - 1) & ~(sizeof(long) - 1))
+#endif
+#endif
+
+#ifndef ERESTART
+#define ERESTART 700
+#endif
+
+#ifndef UIO_MAXIOV
+#define UIO_MAXIOV 1024
+#endif
+#ifndef IOV_MAX
+#define IOV_MAX UIO_MAXIOV
+#endif
+// BSD types for non-BSD newlib:
+#ifndef u_long
+typedef unsigned long  u_long;
+#endif
+#ifndef u_int
+typedef unsigned int   u_int;
+#endif
+#ifndef u_char
+typedef unsigned char  u_char;
+#endif
+#ifndef u_short
+typedef unsigned short u_short;
+#endif
+#ifndef caddr_t
+typedef char*          caddr_t;
+#endif
+
+// Switch lwIP compatibility defines
+#ifndef IFNAMSIZ
+#define IFNAMSIZ 16
+#endif
+
+// IN_MULTICAST macro
+#ifndef IN_MULTICAST
+#define IN_MULTICAST(i) (((uint32_t)(i) & 0xf0000000U) == 0xe0000000U)
+#endif
+
+// struct route_in6 stub
+struct route_in6 {
+    struct rtentry *ro_rt;
+    struct sockaddr_in6 ro_dst;
+};
