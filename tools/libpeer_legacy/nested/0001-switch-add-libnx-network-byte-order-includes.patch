Subject: [PATCH] switch: add libnx network byte-order includes

From: zhouyang <zhouyang@leyantech.com>

---
 crypto/include/datatypes.h | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/crypto/include/datatypes.h b/crypto/include/datatypes.h
index 5164cf0..42668fa 100644
--- a/crypto/include/datatypes.h
+++ b/crypto/include/datatypes.h
@@ -56,11 +56,30 @@
 #include <time.h>
 #ifdef HAVE_NETINET_IN_H
 #include <netinet/in.h>
+#if defined(__SWITCH__)
+#include <arpa/inet.h>
+#endif
+#if defined(__SWITCH__)
+#include <arpa/inet.h>
+#endif
 #elif defined HAVE_WINSOCK2_H
 #include <winsock2.h>
 #else
+#if defined(__SWITCH__)
+#include <netinet/in.h>
+#if defined(__SWITCH__)
+#include <arpa/inet.h>
+#endif
+#include <arpa/inet.h>
+#else
+#if defined(__SWITCH__)
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#else
 #error "Platform not recognized"
 #endif
+#endif
+#endif
 
 #ifdef __cplusplus
 extern "C" {
@@ -179,6 +198,12 @@ static inline uint32_t be32_to_cpu(uint32_t v)
 #else /* HAVE_X86 */
 #ifdef HAVE_NETINET_IN_H
 #include <netinet/in.h>
+#if defined(__SWITCH__)
+#include <arpa/inet.h>
+#endif
+#if defined(__SWITCH__)
+#include <arpa/inet.h>
+#endif
 #elif defined HAVE_WINSOCK2_H
 #include <winsock2.h>
 #endif /* HAVE_NETINET_IN_H */
