+static int peer_connection_send_remb(PeerConnection* pc, uint32_t bitrate_bps) {
+  uint8_t packet[24];
+  memset(packet, 0, sizeof(packet));
+  RtcpHeader* header = (RtcpHeader*)packet;
+  header->version = 2;
+  header->rc = 15;  // PSFB application-layer feedback (REMB).
+  header->type = RTCP_PSFB;
+  header->length = htons(5);
+
+  uint32_t sender_ssrc = htonl(SSRC_H264);
+  memcpy(packet + 4, &sender_ssrc, sizeof(sender_ssrc));
+  memcpy(packet + 12, "REMB", 4);
+  packet[16] = 1;  // one media SSRC follows
+
+  uint32_t exponent = 0;
+  uint32_t mantissa = bitrate_bps;
+  while (mantissa > 0x3ffff && exponent < 0x3f) {
+    mantissa >>= 1;
+    exponent++;
+  }
+  packet[17] = (uint8_t)((exponent << 2) | ((mantissa >> 16) & 0x03));
+  packet[18] = (uint8_t)(mantissa >> 8);
+  packet[19] = (uint8_t)mantissa;
+  uint32_t media_ssrc = htonl(pc->remote_vssrc);
+  memcpy(packet + 20, &media_ssrc, sizeof(media_ssrc));
+  return peer_connection_send_rtcp_packet(pc, packet, sizeof(packet));
+}
