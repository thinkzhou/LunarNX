+static int agent_candidate_pair_index(Agent* agent, IceCandidatePair* pair) {
+  if (!agent || !pair) {
+    return -1;
+  }
+  if (pair < agent->candidate_pairs ||
+      pair >= agent->candidate_pairs + agent->candidate_pairs_num) {
+    return -1;
+  }
+  return (int)(pair - agent->candidate_pairs);
+}
+
+uint64_t agent_candidate_pair_priority(Agent* agent,
+                                       IceCandidate* local,
+                                       IceCandidate* remote) {
+  uint32_t controlling = agent->mode == AGENT_MODE_CONTROLLING
+      ? local->priority
+      : remote->priority;
+  uint32_t controlled = agent->mode == AGENT_MODE_CONTROLLING
+      ? remote->priority
+      : local->priority;
+  uint32_t minimum = controlling < controlled ? controlling : controlled;
+  uint32_t maximum = controlling > controlled ? controlling : controlled;
+  return ((uint64_t)minimum << 32) + (uint64_t)maximum * 2u +
+         (controlling > controlled ? 1u : 0u);
+}
+
+static void agent_initialize_candidate_pair(Agent* agent,
+                                            IceCandidatePair* pair,
+                                            IceCandidate* local,
+                                            IceCandidate* remote) {
+  memset(pair, 0, sizeof(*pair));
+  pair->local = local;
+  pair->remote = remote;
+  pair->priority = agent_candidate_pair_priority(agent, local, remote);
+  pair->state = ICE_CANDIDATE_STATE_FROZEN;
+}
+
+static IceCandidatePair* agent_find_candidate_pair(Agent* agent,
+                                                   IceCandidate* local,
+                                                   IceCandidate* remote) {
+  for (int i = 0; i < agent->candidate_pairs_num; i++) {
+    IceCandidatePair* pair = &agent->candidate_pairs[i];
+    if (pair->local == local && pair->remote == remote) {
+      return pair;
+    }
+  }
+  return NULL;
+}
+
+static IceCandidatePair* agent_add_candidate_pair(Agent* agent,
+                                                  IceCandidate* local,
+                                                  IceCandidate* remote) {
+  IceCandidatePair* existing = agent_find_candidate_pair(agent, local, remote);
+  if (existing) {
+    return existing;
+  }
+  if (agent->candidate_pairs_num >= AGENT_MAX_CANDIDATE_PAIRS) {
+    LOGW("ICE candidate-pair limit reached");
+    return NULL;
+  }
+  IceCandidatePair* pair = &agent->candidate_pairs[agent->candidate_pairs_num++];
+  agent_initialize_candidate_pair(agent, pair, local, remote);
+  return pair;
+}
 
+static void agent_recalculate_pair_priorities(Agent* agent) {
+  for (int i = 0; i < agent->candidate_pairs_num; i++) {
+    IceCandidatePair* pair = &agent->candidate_pairs[i];
+    pair->priority = agent_candidate_pair_priority(agent, pair->local, pair->remote);
+  }
+}
