+static int agent_send_consent_check_now(Agent* agent,
+                                        IceCandidatePair* pair,
+                                        uint32_t now) {
+  StunMessage msg;
+  memset(pair->transaction_id, 0, sizeof(pair->transaction_id));
+  agent_create_binding_request(agent, pair, 0, &msg);
+  const int ret = agent_socket_send(agent, &pair->remote->addr,
+                                    msg.buf, msg.size);
+  if (ret < 0) {
+    memset(pair->transaction_id, 0, sizeof(pair->transaction_id));
+    pair->consent_check_pending = 0;
+    return ret;
+  }
+  pair->last_check_time = now;
+  pair->consent_check_pending = 1;
+  return 0;
+}
+
+int agent_send_consent_check(Agent* agent) {
+  if (!agent || !agent->nominated_pair ||
+      !agent->nominated_pair->nominated ||
+      !agent->nominated_pair->local || !agent->nominated_pair->remote) {
+    return -1;
+  }
+  IceCandidatePair* pair = agent->nominated_pair;
+  const uint32_t now = ports_get_epoch_time();
+  if (pair->consent_check_pending &&
+      now - pair->last_check_time < AGENT_CHECK_RTO_MS) {
+    return 0;
+  }
+  if (agent->last_check_time != 0 &&
+      now - agent->last_check_time < AGENT_CONSENT_INTERVAL_MS) {
+    return 0;
+  }
+  const int ret = agent_send_consent_check_now(agent, pair, now);
+  if (ret >= 0) agent->last_check_time = now;
+  return ret;
 }
 
