+static int peer_connection_send_receiver_report(PeerConnection* pc,
+                                                 uint8_t fraction_lost,
+                                                 uint32_t cumulative_lost,
+                                                 uint32_t highest_seq_ext,
+                                                 uint32_t jitter) {
+  uint8_t packet[128];
+  memset(packet, 0, sizeof(packet));
+  static const char kCname[] = "lunarnx";
+  uint32_t sender_ssrc = htonl(SSRC_H264);
+  uint32_t media_ssrc = htonl(pc->remote_vssrc);
+
+  RtcpHeader* rr = (RtcpHeader*)packet;
+  rr->version = 2;
+  rr->rc = 1;
+  rr->type = RTCP_RR;
+  rr->length = htons(7);  // 32-byte receiver report
+  memcpy(packet + 4, &sender_ssrc, sizeof(sender_ssrc));
+  memcpy(packet + 8, &media_ssrc, sizeof(media_ssrc));
+  uint32_t loss = htonl((uint32_t)fraction_lost << 24 |
+                        (cumulative_lost & 0x00ffffff));
+  memcpy(packet + 12, &loss, sizeof(loss));
+  uint32_t highest = htonl(highest_seq_ext);
+  memcpy(packet + 16, &highest, sizeof(highest));
+  uint32_t network_jitter = htonl(jitter);
+  memcpy(packet + 20, &network_jitter, sizeof(network_jitter));
+  uint32_t lsr = htonl(pc->rtcp_last_sr_lsr);
+  memcpy(packet + 24, &lsr, sizeof(lsr));
+  uint32_t dlsr = 0;
+  if (pc->rtcp_last_sr_time_ms != 0) {
+    uint32_t delta_ms = ports_get_epoch_time() - pc->rtcp_last_sr_time_ms;
+    dlsr = htonl((uint32_t)(((uint64_t)delta_ms << 16) / 1000));
+  }
+  memcpy(packet + 28, &dlsr, sizeof(dlsr));
+
+  // SDES/CNAME makes this a standards-compliant compound RR and prevents
+  // senders that require RTCP compound packets from ignoring the report.
+  const int sdes_offset = 32;
+  RtcpHeader* sdes = (RtcpHeader*)(packet + sdes_offset);
+  sdes->version = 2;
+  sdes->rc = 1;
+  sdes->type = RTCP_SDES;
+  memcpy(packet + sdes_offset + 4, &sender_ssrc, sizeof(sender_ssrc));
+  int cursor = sdes_offset + 8;
+  packet[cursor++] = 1;  // CNAME item
+  packet[cursor++] = (uint8_t)(sizeof(kCname) - 1);
+  memcpy(packet + cursor, kCname, sizeof(kCname) - 1);
+  cursor += sizeof(kCname) - 1;
+  packet[cursor++] = 0;
+  while ((cursor - sdes_offset) % 4 != 0) packet[cursor++] = 0;
+  sdes->length = htons((uint16_t)((cursor - sdes_offset) / 4 - 1));
+  return peer_connection_send_rtcp_packet(pc, packet, cursor);
+}
+
+int peer_connection_send_receiver_feedback(PeerConnection* pc,
+                                            uint32_t bitrate_bps) {
+  if (!pc || pc->state != PEER_CONNECTION_COMPLETED || bitrate_bps == 0) {
+    return -1;
+  }
+  RtpDecoderStats stats;
+  rtp_decoder_get_stats(&pc->vrtp_decoder, &stats);
+  uint32_t expected_delta = stats.highest_seq_ext >= pc->rtcp_last_report_highest
+      ? stats.highest_seq_ext - pc->rtcp_last_report_highest : 0;
+  uint32_t missing_delta = stats.missing_packets >= pc->rtcp_last_report_missing
+      ? stats.missing_packets - pc->rtcp_last_report_missing : 0;
+  uint8_t fraction = 0;
+  if (expected_delta > 0) {
+    uint32_t lost = missing_delta;
+    if (lost > expected_delta) lost = expected_delta;
+    uint64_t fraction_value = ((uint64_t)lost * 256u) / expected_delta;
+    fraction = (uint8_t)fraction_value;
+    if (fraction > 255) fraction = 255;
+  }
+  pc->rtcp_last_report_missing = stats.missing_packets;
+  pc->rtcp_last_report_highest = stats.highest_seq_ext;
+  uint32_t cumulative = stats.missing_packets > 0x00ffffff
+      ? 0x00ffffff : stats.missing_packets;
+  int rr_ret = peer_connection_send_receiver_report(pc, fraction, cumulative,
+                                                     stats.highest_seq_ext, 0);
+  int remb_ret = peer_connection_send_remb(pc, bitrate_bps);
+  return rr_ret < 0 ? rr_ret : remb_ret;
+}
+
+int peer_connection_send_receiver_feedback_stats(PeerConnection* pc,
