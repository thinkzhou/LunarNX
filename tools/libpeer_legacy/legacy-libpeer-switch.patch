+static int agent_has_candidate_address(Agent* agent, const Address* addr) {
+  for (int i = 0; i < agent->local_candidates_count; i++) {
+    const Address* existing = &agent->local_candidates[i].addr;
+    if (existing->family != addr->family || existing->port != addr->port) {
+      continue;
+    }
+    if (addr->family == AF_INET6 &&
+        memcmp(&existing->sin6.sin6_addr,
+               &addr->sin6.sin6_addr,
+               sizeof(addr->sin6.sin6_addr)) == 0) {
+      return 1;
+    }
+    if (addr->family == AF_INET &&
+        existing->sin.sin_addr.s_addr == addr->sin.sin_addr.s_addr) {
+      return 1;
+    }
+  }
+  return 0;
+}
+
+static IceCandidate* agent_find_host_candidate(Agent* agent, int family) {
+  IceCandidate* best = NULL;
+  for (int i = 0; i < agent->local_candidates_count; i++) {
+    IceCandidate* candidate = &agent->local_candidates[i];
+    if (candidate->type == ICE_CANDIDATE_TYPE_HOST &&
+        candidate->addr.family == family &&
+        (!best || candidate->priority > best->priority)) {
+      best = candidate;
+    }
+  }
+  return best;
+}
+
+static int agent_address_is_usable(const Address* addr) {
+  if (!addr || addr->port == 0) {
+    return 0;
+  }
+  if (addr->family == AF_INET6) {
+    return !IN6_IS_ADDR_UNSPECIFIED(&addr->sin6.sin6_addr);
+  }
+  return addr->family == AF_INET &&
+         addr->sin.sin_addr.s_addr != htonl(INADDR_ANY);
+}
