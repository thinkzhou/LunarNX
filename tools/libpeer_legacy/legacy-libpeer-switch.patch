+static int peer_connection_send_rtcp_packet(PeerConnection* pc,
+                                             const uint8_t* packet,
+                                             int packet_len) {
+  if (!pc || !packet || packet_len <= 0) return -1;
+
+  // libSRTP protects RTCP in place and may append
+  // SRTP_MAX_TRAILER_LEN + 4 bytes.  NACK and REMB used exact-size stack
+  // arrays before reaching this helper, so the first feedback packet could
+  // overwrite the caller's stack on Switch.  Copy every plain RTCP packet
+  // into one aligned, capacity-checked scratch buffer before protection.
+  union {
+    uint32_t alignment;
+    uint8_t bytes[CONFIG_PACKET_BUFFER_SIZE];
+  } protected_packet;
+  const size_t trailer_capacity = SRTP_MAX_TRAILER_LEN + 4;
+  if ((size_t)packet_len > sizeof(protected_packet.bytes) - trailer_capacity) {
+    return -1;
+  }
+  memcpy(protected_packet.bytes, packet, (size_t)packet_len);
+
+  int protected_len = packet_len;
+  int protect_ret = dtls_srtp_encrypt_rctp_packet(&pc->dtls_srtp,
+                                                  protected_packet.bytes,
+                                                  &protected_len,
+                                                  sizeof(protected_packet.bytes));
+  if (protect_ret != srtp_err_status_ok) return -1;
+  return agent_send(&pc->agent, protected_packet.bytes, protected_len);
+}
