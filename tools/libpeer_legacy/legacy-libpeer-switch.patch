+                                                  uint32_t cumulative_lost,
+                                                  uint32_t highest_seq_ext,
+                                                  uint32_t jitter,
+                                                  uint32_t bitrate_bps) {
+  if (!pc || pc->state != PEER_CONNECTION_COMPLETED || bitrate_bps == 0) {
+    return -1;
+  }
+  int rr_ret = peer_connection_send_receiver_report(
+      pc, fraction_lost, cumulative_lost, highest_seq_ext, jitter);
+  int remb_ret = peer_connection_send_remb(pc, bitrate_bps);
+  return rr_ret < 0 ? rr_ret : remb_ret;
 }
 
