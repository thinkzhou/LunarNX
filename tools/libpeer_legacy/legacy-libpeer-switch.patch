+static int agent_socket_recv_nonblocking(Agent* agent,
+                                         Address* addr,
+                                         uint8_t* buf,
+                                         int len) {
+  const int socket_count = (int)(sizeof(agent->udp_sockets) /
+                                 sizeof(agent->udp_sockets[0]));
+  int first_socket = 0;
+  int last_error = 0;
+
+#if CONFIG_IPV6
+  if (agent->nominated_pair && agent->nominated_pair->local &&
+      agent->nominated_pair->local->addr.family == AF_INET6) {
+    first_socket = 1;
+  }
+#endif
+
+  for (int offset = 0; offset < socket_count; offset++) {
+    const int index = (first_socket + offset) % socket_count;
+#if !CONFIG_IPV6
+    if (index > 0) {
+      continue;
+    }
+#endif
+    if (agent->udp_sockets[index].fd < 0) {
+      continue;
+    }
+    const int ret = udp_socket_recvfrom_nonblocking(
+        &agent->udp_sockets[index], addr, buf, len);
+    if (ret > 0) {
+      return ret;
+    }
+    if (ret < 0) {
+      last_error = ret;
+    }
+  }
+  return last_error;
