+  const StunHeader* request_header = (const StunHeader*)request->buf;
+  const StunHeader* response_header = (const StunHeader*)response->buf;
+  return memcmp(request_header->transaction_id,
+                response_header->transaction_id,
+                sizeof(request_header->transaction_id)) == 0;
+}
