+CHIAKI_EXPORT long chiaki_holepunch_session_get_last_http_status(
+    ChiakiHolepunchSession session)
+{
+    return session
+        ? atomic_load_explicit(&session->last_http_status, memory_order_relaxed)
+        : 0;
+}
+
+static void record_last_http_status(Session *session, CURL *curl)
+{
+    if(!session || !curl)
+        return;
+    long http_status = 0;
+    if(curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &http_status) == CURLE_OK)
+        atomic_store_explicit(&session->last_http_status, http_status,
+            memory_order_relaxed);
+}
