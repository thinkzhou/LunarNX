+CHIAKI_EXPORT void chiaki_holepunch_session_set_preferred_stun_server(
+    Session *session, const char *host, uint16_t port)
+{
+    if(!session)
+        return;
+    snprintf(session->preferred_stun_host, sizeof(session->preferred_stun_host),
+        "%s", host ? host : "");
+    session->preferred_stun_port = host && host[0] ? port : 0;
+}
+
+CHIAKI_EXPORT void chiaki_holepunch_session_set_preferred_remote_candidate(
+    Session *session, const char *address, uint16_t port)
+{
+    if(!session)
+        return;
+    snprintf(session->preferred_remote_address,
+        sizeof(session->preferred_remote_address), "%s", address ? address : "");
+    session->preferred_remote_port = address && address[0] ? port : 0;
+}
+
+CHIAKI_EXPORT bool chiaki_holepunch_session_get_successful_stun_server(
+    Session *session, char *host, size_t host_size, uint16_t *port)
+{
+    if(!session || !host || host_size == 0 || !port ||
+        session->successful_stun_host[0] == '\0' ||
+        session->successful_stun_port == 0)
+        return false;
+    snprintf(host, host_size, "%s", session->successful_stun_host);
+    *port = session->successful_stun_port;
+    return true;
+}
+
+CHIAKI_EXPORT bool chiaki_holepunch_session_get_selected_remote_candidate(
+    Session *session, char *address, size_t address_size, uint16_t *port)
+{
+    if(!session || !address || address_size == 0 || !port ||
+        session->ps_ip[0] == '\0' || session->selected_remote_port == 0)
+        return false;
+    snprintf(address, address_size, "%s", session->ps_ip);
+    *port = session->selected_remote_port;
+    return true;
+}
