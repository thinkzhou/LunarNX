+static json_object *relay_exchange(Session *session, json_object *request, bool challenge)
+{
+    const char *payload = json_object_to_json_string_ext(request, JSON_C_TO_STRING_PLAIN);
+    json_object *cmd_value = NULL;
+    const char *cmd = json_object_object_get_ex(request, "cmd", &cmd_value)
+        ? json_object_get_string(cmd_value) : "unknown";
+    uint8_t request_id_bytes[16];
+    if(chiaki_random_bytes_crypt(request_id_bytes, sizeof(request_id_bytes)) != CHIAKI_ERR_SUCCESS)
+        return NULL;
+    char request_id[sizeof(request_id_bytes) * 2 + 1];
+    bytes_to_hex(request_id_bytes, sizeof(request_id_bytes), request_id, sizeof(request_id));
+
+    json_object *envelope = json_object_new_object();
+    if(!envelope)
+        return NULL;
+    json_object_object_add(envelope, "version", json_object_new_int(RELAY_CONTROL_VERSION));
+    json_object_object_add(envelope, "request_id", json_object_new_string(request_id));
+    json_object_object_add(envelope, "payload", json_object_new_string(payload));
+    if(!challenge)
+    {
+        char digest[65];
+        if(!relay_compute_hmac(session, "request", request_id,
+            session->relay_nonce, payload, digest))
+        {
+            json_object_put(envelope);
+            return NULL;
+        }
+        json_object_object_add(envelope, "nonce", json_object_new_string(session->relay_nonce));
+        json_object_object_add(envelope, "hmac", json_object_new_string(digest));
+    }
+    const char *packet = json_object_to_json_string_ext(envelope, JSON_C_TO_STRING_PLAIN);
+    size_t packet_size = strlen(packet);
+    if(packet_size == 0 || packet_size > RELAY_CONTROL_MAX_DATAGRAM)
+    {
+        json_object_put(envelope);
+        return NULL;
+    }
+    char *response_data = malloc(RELAY_CONTROL_MAX_DATAGRAM + 1);
+    if(!response_data)
+    {
+        json_object_put(envelope);
+        return NULL;
+    }
+
+    json_object *response = NULL;
+    CHIAKI_LOGV(session->log, "UDP relay sending %s request (%u-byte datagram)",
+        cmd, (unsigned int)packet_size);
+    bool http_request = strcmp(cmd, "session_message") == 0;
+    int max_attempts = http_request ? 2 : RELAY_CONTROL_RETRY_COUNT;
+    uint64_t response_timeout = http_request
+        ? RELAY_CONTROL_HTTP_TIMEOUT_MS : RELAY_CONTROL_RETRY_TIMEOUT_MS;
+    for(int attempt = 1; attempt <= max_attempts && !response; attempt++)
+    {
+        CHIAKI_SSIZET_TYPE sent = send(session->relay_control_sock, packet, packet_size, 0);
+        if(sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+        {
+            struct pollfd write_event = {.fd = session->relay_control_sock, .events = POLLOUT};
+            poll(&write_event, 1, 100);
+            sent = send(session->relay_control_sock, packet, packet_size, 0);
+        }
+        if(sent != (CHIAKI_SSIZET_TYPE)packet_size)
+        {
+            CHIAKI_LOGW(session->log, "UDP relay %s send attempt %d failed: " CHIAKI_SOCKET_ERROR_FMT,
+                cmd, attempt, CHIAKI_SOCKET_ERROR_VALUE);
+            continue;
+        }
+
+        uint64_t deadline = chiaki_time_now_monotonic_ms() + response_timeout;
+        while(chiaki_time_now_monotonic_ms() < deadline && !response)
+        {
+            uint64_t remaining = deadline - chiaki_time_now_monotonic_ms();
+            struct pollfd read_event = {.fd = session->relay_control_sock, .events = POLLIN};
+            int ready = poll(&read_event, 1, (int)remaining);
+            if(ready < 0 && errno == EINTR)
+                continue;
+            if(ready <= 0)
+                break;
+            CHIAKI_SSIZET_TYPE received = recv(session->relay_control_sock, response_data,
+                RELAY_CONTROL_MAX_DATAGRAM, MSG_DONTWAIT);
+            if(received <= 0)
+                continue;
+            response_data[received] = '\0';
+            json_object *response_envelope = json_tokener_parse(response_data);
+            json_object *version_value = NULL, *id_value = NULL, *nonce_value = NULL;
+            json_object *payload_value = NULL, *hmac_value = NULL;
+            bool parsed = response_envelope != NULL;
+            bool version_valid = parsed
+                && json_object_object_get_ex(response_envelope, "version", &version_value)
+                && json_object_get_int(version_value) == RELAY_CONTROL_VERSION;
+            bool request_id_valid = parsed
+                && json_object_object_get_ex(response_envelope, "request_id", &id_value)
+                && strcmp(json_object_get_string(id_value), request_id) == 0;
+            bool fields_present = parsed
+                && json_object_object_get_ex(response_envelope, "nonce", &nonce_value)
+                && json_object_object_get_ex(response_envelope, "payload", &payload_value)
+                && json_object_object_get_ex(response_envelope, "hmac", &hmac_value);
+            bool valid = parsed && version_valid && request_id_valid && fields_present;
+            const char *response_nonce = valid ? json_object_get_string(nonce_value) : NULL;
+            const char *response_payload = valid ? json_object_get_string(payload_value) : NULL;
+            const char *response_hmac = valid ? json_object_get_string(hmac_value) : NULL;
+            bool nonce_valid = valid && relay_valid_hex(response_nonce, 64)
+                && (challenge || strcmp(response_nonce, session->relay_nonce) == 0);
+            char expected_hmac[65];
+            bool hmac_valid = nonce_valid
+                && relay_compute_hmac(session, "response", request_id,
+                response_nonce, response_payload, expected_hmac)
+                && relay_constant_time_equal(response_hmac, expected_hmac, 64);
+            valid = valid && nonce_valid && hmac_valid;
+            if(valid)
+            {
+                response = json_tokener_parse(response_payload);
+                if(response && challenge)
+                    memcpy(session->relay_nonce, response_nonce, 65);
+            }
+            if(response_envelope)
+                json_object_put(response_envelope);
+        }
+        if(!response && attempt < max_attempts)
+            CHIAKI_LOGW(session->log, "UDP relay %s response timeout; retrying request_id=%s attempt=%d",
+                cmd, request_id, attempt + 1);
+    }
+    free(response_data);
+    json_object_put(envelope);
+    if(!response)
+    {
+        CHIAKI_LOGE(session->log, "UDP relay %s request timed out after %d attempts",
+            cmd, max_attempts);
+        return NULL;
+    }
+    json_object *ok = NULL;
+    if(!json_object_object_get_ex(response, "ok", &ok) || !json_object_get_boolean(ok))
+    {
+        json_object *error = NULL;
+        CHIAKI_LOGE(session->log, "UDP relay request failed: %s",
+            json_object_object_get_ex(response, "error", &error)
+                ? json_object_get_string(error) : "invalid response");
+        json_object_put(response);
+        return NULL;
+    }
+    CHIAKI_LOGV(session->log, "UDP relay received authenticated %s response", cmd);
+    return response;
+}
+
+static json_object *relay_request(Session *session, json_object *request)
+{
+    return relay_exchange(session, request, false);
+}
+
+static ChiakiErrorCode relay_post_session_message(Session *session,
+    const char *body)
+{
+    size_t body_size = strlen(body);
+    size_t encoded_size = 4 * ((body_size + 2) / 3) + 1;
+    char *encoded = malloc(encoded_size);
+    if(!encoded)
+        return CHIAKI_ERR_MEMORY;
+    ChiakiErrorCode err = chiaki_base64_encode(
+        (const uint8_t *)body, body_size, encoded, encoded_size);
+    if(err != CHIAKI_ERR_SUCCESS)
+    {
+        free(encoded);
+        return err;
+    }
+    json_object *request = json_object_new_object();
+    json_object_object_add(request, "cmd", json_object_new_string("session_message"));
+    json_object_object_add(request, "session_id",
+        json_object_new_string(session->session_id));
+    json_object_object_add(request, "body_base64", json_object_new_string(encoded));
+    free(encoded);
+    json_object *response = relay_request(session, request);
+    json_object_put(request);
+    if(!response)
+        return CHIAKI_ERR_NETWORK;
+    json_object *status_value = NULL, *elapsed_value = NULL;
+    int status = json_object_object_get_ex(response, "status", &status_value)
+        ? json_object_get_int(status_value) : 0;
+    double elapsed_ms = json_object_object_get_ex(response, "elapsed_ms", &elapsed_value)
+        ? json_object_get_double(elapsed_value) : 0.0;
+    json_object_put(response);
+    if(status < 200 || status >= 300)
+        return CHIAKI_ERR_HTTP_NONOK;
+    CHIAKI_LOGI(session->log,
+        "Ryubing PSN session message proxy completed status=%d elapsed_ms=%.1f",
+        status, elapsed_ms);
+    return CHIAKI_ERR_SUCCESS;
+}
+
+static ChiakiErrorCode relay_connect(Session *session)
+{
+    if(!CHIAKI_SOCKET_IS_INVALID(session->relay_control_sock))
+        return CHIAKI_ERR_SUCCESS;
+    chiaki_socket_t sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if(CHIAKI_SOCKET_IS_INVALID(sock))
+        return CHIAKI_ERR_NETWORK;
+    if(chiaki_socket_set_nonblock(sock, true) != CHIAKI_ERR_SUCCESS)
+    {
+        CHIAKI_SOCKET_CLOSE(sock);
+        return CHIAKI_ERR_NETWORK;
+    }
+    struct sockaddr_in address = {0};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(session->relay_port);
+    if(inet_pton(AF_INET, session->relay_host, &address.sin_addr) != 1
+        || connect(sock, (struct sockaddr *)&address, sizeof(address)) < 0)
+    {
+        CHIAKI_SOCKET_CLOSE(sock);
+        return CHIAKI_ERR_NETWORK;
+    }
+    session->relay_control_sock = sock;
+    json_object *challenge = json_object_new_object();
+    json_object_object_add(challenge, "cmd", json_object_new_string("challenge"));
+    json_object *response = relay_exchange(session, challenge, true);
+    json_object_put(challenge);
+    if(!response)
+    {
+        relay_close(session);
+        return CHIAKI_ERR_NETWORK;
+    }
+    json_object_put(response);
+    CHIAKI_LOGI(session->log, "Connected to Ryubing UDP relay control at %s:%u",
+        session->relay_host, session->relay_port);
+    return CHIAKI_ERR_SUCCESS;
+}
+
+static const char *relay_channel_name(ChiakiHolepunchPortType type)
+{
+    return type == CHIAKI_HOLEPUNCH_PORT_TYPE_CTRL ? "ctrl" : "data";
+}
+
+static ChiakiErrorCode relay_open_channel(Session *session,
+    ChiakiHolepunchPortType port_type)
+{
+    ChiakiErrorCode err = relay_connect(session);
+    if(err != CHIAKI_ERR_SUCCESS)
+        return err;
+    json_object *request = json_object_new_object();
+    json_object_object_add(request, "cmd", json_object_new_string("open"));
+    json_object_object_add(request, "connection_id",
+        json_object_new_string(session->relay_connection_id));
+    json_object_object_add(request, "channel", json_object_new_string(relay_channel_name(port_type)));
+    json_object *response = relay_request(session, request);
+    json_object_put(request);
+    if(!response)
+        return CHIAKI_ERR_NETWORK;
+    json_object *host = NULL, *mapped_port = NULL, *tunnel_port = NULL;
+    bool valid = json_object_object_get_ex(response, "mapped_host", &host)
+        && json_object_object_get_ex(response, "mapped_port", &mapped_port)
+        && json_object_object_get_ex(response, "tunnel_port", &tunnel_port);
+    int index = port_type == CHIAKI_HOLEPUNCH_PORT_TYPE_CTRL ? 0 : 1;
+    const char *host_text = valid ? json_object_get_string(host) : NULL;
+    int mapped = valid ? json_object_get_int(mapped_port) : 0;
+    int tunnel = valid ? json_object_get_int(tunnel_port) : 0;
+    if(!host_text || strlen(host_text) >= sizeof(session->relay_mapped_host[index])
+        || mapped <= 0 || mapped > UINT16_MAX || tunnel <= 0 || tunnel > UINT16_MAX)
+        valid = false;
+    if(valid)
+    {
+        memcpy(session->relay_mapped_host[index], host_text, strlen(host_text) + 1);
+        session->relay_mapped_port[index] = (uint16_t)mapped;
+        session->relay_tunnel_port[index] = (uint16_t)tunnel;
+        CHIAKI_LOGI(session->log, "UDP relay %s mapped at %s:%u tunnel=%s:%u",
+            relay_channel_name(port_type), host_text, mapped,
+            session->relay_host, tunnel);
+    }
+    json_object_put(response);
+    return valid ? CHIAKI_ERR_SUCCESS : CHIAKI_ERR_INVALID_DATA;
+}
+
+static ChiakiErrorCode relay_set_peers(Session *session,
+    ChiakiHolepunchPortType port_type, Candidate *candidates, size_t count)
+{
+    json_object *request = json_object_new_object();
+    json_object_object_add(request, "cmd", json_object_new_string("peers"));
+    json_object_object_add(request, "connection_id",
+        json_object_new_string(session->relay_connection_id));
+    json_object_object_add(request, "channel", json_object_new_string(relay_channel_name(port_type)));
+    json_object *peers = json_object_new_array();
+    for(size_t i = 0; i < count; i++)
+    {
+        struct in_addr address;
+        if(inet_pton(AF_INET, candidates[i].addr, &address) != 1 || candidates[i].port == 0)
+            continue;
+        json_object *peer = json_object_new_object();
+        json_object_object_add(peer, "host", json_object_new_string(candidates[i].addr));
+        json_object_object_add(peer, "port", json_object_new_int(candidates[i].port));
+        json_object_array_add(peers, peer);
+    }
+    json_object_object_add(request, "peers", peers);
+    json_object *response = relay_request(session, request);
+    json_object_put(request);
+    if(!response)
+        return CHIAKI_ERR_NETWORK;
+    json_object_put(response);
+    return CHIAKI_ERR_SUCCESS;
+}
+
+static ChiakiErrorCode relay_get_selected_peer(Session *session,
+    ChiakiHolepunchPortType port_type, Candidate *candidates, size_t count,
+    Candidate *selected_candidate)
+{
+    json_object *request = json_object_new_object();
+    json_object_object_add(request, "cmd", json_object_new_string("status"));
+    json_object_object_add(request, "connection_id",
+        json_object_new_string(session->relay_connection_id));
+    json_object *response = relay_request(session, request);
+    json_object_put(request);
+    if(!response)
+        return CHIAKI_ERR_NETWORK;
+    json_object *channels = NULL, *channel = NULL, *selected = NULL;
+    const char *selected_text = NULL;
+    if(json_object_object_get_ex(response, "channels", &channels)
+        && json_object_object_get_ex(channels, relay_channel_name(port_type), &channel)
+        && json_object_object_get_ex(channel, "selected_peer", &selected))
+        selected_text = json_object_get_string(selected);
+    bool valid = selected_text != NULL;
+    if(valid)
+    {
+        const char *colon = strrchr(selected_text, ':');
+        size_t host_size = colon ? (size_t)(colon - selected_text) : 0;
+        int port = colon ? atoi(colon + 1) : 0;
+        valid = host_size > 0 && host_size < sizeof(selected_candidate->addr)
+            && port > 0 && port <= UINT16_MAX;
+        if(valid)
+        {
+            bool exact_candidate = false;
+            for(size_t i = 0; i < count; i++)
+            {
+                if(candidates[i].port != (uint16_t)port
+                    || strlen(candidates[i].addr) != host_size
+                    || strncmp(candidates[i].addr, selected_text, host_size) != 0)
+                    continue;
+                memcpy(selected_candidate, &candidates[i], sizeof(*selected_candidate));
+                exact_candidate = true;
+                break;
+            }
+            if(!exact_candidate)
+            {
+                memset(selected_candidate, 0, sizeof(*selected_candidate));
+                memcpy(selected_candidate->addr, selected_text, host_size);
+                selected_candidate->port = (uint16_t)port;
+                selected_candidate->type = CANDIDATE_TYPE_DERIVED;
+            }
+            CHIAKI_LOGI(session->log, "UDP relay %s selected %s candidate %s:%u type=%d",
+                relay_channel_name(port_type), exact_candidate ? "offered" : "derived",
+                selected_candidate->addr, selected_candidate->port,
+                selected_candidate->type);
+        }
+    }
+    json_object_put(response);
+    return valid ? CHIAKI_ERR_SUCCESS : CHIAKI_ERR_INVALID_DATA;
+}
+
+static void relay_close(Session *session)
+{
+    if(!CHIAKI_SOCKET_IS_INVALID(session->relay_control_sock))
+    {
+        if(session->relay_nonce[0] != '\0')
+        {
+            json_object *request = json_object_new_object();
+            json_object_object_add(request, "cmd",
+                json_object_new_string("close_connection"));
+            json_object_object_add(request, "connection_id",
+                json_object_new_string(session->relay_connection_id));
+            json_object *response = relay_request(session, request);
+            if(response)
+                json_object_put(response);
+            json_object_put(request);
+        }
+        CHIAKI_SOCKET_CLOSE(session->relay_control_sock);
+        session->relay_control_sock = CHIAKI_INVALID_SOCKET;
+    }
+}
+#else
+static ChiakiErrorCode relay_open_channel(Session *session, ChiakiHolepunchPortType type)
+{ (void)session; (void)type; return CHIAKI_ERR_UNKNOWN; }
+static ChiakiErrorCode relay_set_peers(Session *session, ChiakiHolepunchPortType type, Candidate *c, size_t n)
+{ (void)session; (void)type; (void)c; (void)n; return CHIAKI_ERR_UNKNOWN; }
+static ChiakiErrorCode relay_get_selected_peer(Session *session, ChiakiHolepunchPortType type,
+    Candidate *candidates, size_t count, Candidate *selected_candidate)
+{ (void)session; (void)type; (void)candidates; (void)count; (void)selected_candidate; return CHIAKI_ERR_UNKNOWN; }
+static ChiakiErrorCode relay_post_session_message(Session *session, const char *body)
+{ (void)session; (void)body; return CHIAKI_ERR_UNKNOWN; }
+static void relay_close(Session *session) { (void)session; }
+#endif
