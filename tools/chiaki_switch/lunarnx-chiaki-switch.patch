+#if !defined(_WIN32)
+#define RELAY_CONTROL_VERSION 3
+// Ryubing returns zero bytes for larger recv lengths even when a small UDP datagram is queued.
+#define RELAY_CONTROL_MAX_DATAGRAM (4 * 1024)
+#define RELAY_CONTROL_RETRY_COUNT 6
+#define RELAY_CONTROL_RETRY_TIMEOUT_MS 1000
+#define RELAY_CONTROL_HTTP_TIMEOUT_MS 20000
+
+static const char relay_hmac_label[] = "LUNARNX-PS-UDP-RELAY-V3";
+
+static bool relay_valid_hex(const char *value, size_t chars)
+{
+    if(!value || strlen(value) != chars || chars > 64 || (chars & 1) != 0)
+        return false;
+    uint8_t bytes[32];
+    return hex_to_bytes(value, bytes, chars / 2) == CHIAKI_ERR_SUCCESS;
+}
+
+static bool relay_constant_time_equal(const char *left, const char *right, size_t size)
+{
+    if(!left || !right || strlen(left) != size || strlen(right) != size)
+        return false;
+    uint8_t difference = 0;
+    for(size_t i = 0; i < size; i++)
+        difference |= (uint8_t)left[i] ^ (uint8_t)right[i];
+    return difference == 0;
+}
+
+static bool relay_compute_hmac(Session *session, const char *direction,
+    const char *request_id, const char *nonce, const char *payload, char output[65])
+{
+#ifdef CHIAKI_LIB_ENABLE_MBEDTLS
+    const mbedtls_md_info_t *info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+    if(!info)
+        return false;
+    mbedtls_md_context_t context;
+    mbedtls_md_init(&context);
+    bool success = mbedtls_md_setup(&context, info, 1) == 0
+        && mbedtls_md_hmac_starts(&context,
+            (const uint8_t *)session->relay_secret, strlen(session->relay_secret)) == 0;
+    const char *parts[] = {relay_hmac_label, direction, request_id, nonce, payload};
+    const uint8_t separator = 0;
+    for(size_t i = 0; success && i < sizeof(parts) / sizeof(parts[0]); i++)
+    {
+        success = mbedtls_md_hmac_update(&context,
+            (const uint8_t *)parts[i], strlen(parts[i])) == 0;
+        if(success && i + 1 < sizeof(parts) / sizeof(parts[0]))
+            success = mbedtls_md_hmac_update(&context, &separator, 1) == 0;
+    }
+    uint8_t digest[32];
+    if(success)
+        success = mbedtls_md_hmac_finish(&context, digest) == 0;
+    mbedtls_md_free(&context);
+    if(success)
+        bytes_to_hex(digest, sizeof(digest), output, 65);
+    return success;
+#else
+    const char *parts[] = {relay_hmac_label, direction, request_id, nonce, payload};
+    size_t message_size = sizeof(parts) / sizeof(parts[0]) - 1;
+    for(size_t i = 0; i < sizeof(parts) / sizeof(parts[0]); i++)
+        message_size += strlen(parts[i]);
+    uint8_t *message = malloc(message_size);
+    if(!message)
+        return false;
+    size_t offset = 0;
+    for(size_t i = 0; i < sizeof(parts) / sizeof(parts[0]); i++)
+    {
+        size_t part_size = strlen(parts[i]);
+        memcpy(message + offset, parts[i], part_size);
+        offset += part_size;
+        if(i + 1 < sizeof(parts) / sizeof(parts[0]))
+            message[offset++] = 0;
+    }
+    uint8_t digest[EVP_MAX_MD_SIZE];
+    unsigned int digest_size = 0;
+    bool success = HMAC(EVP_sha256(), session->relay_secret,
+        (int)strlen(session->relay_secret), message, message_size,
+        digest, &digest_size) != NULL && digest_size == 32;
+    free(message);
+    if(success)
+        bytes_to_hex(digest, digest_size, output, 65);
+    return success;
+#endif
+}
